  },
  "homepage": "https://github.com/Vissem04/SmartNote#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.80.0",
    "multer": "^2.5.0",
    "perfect-freehand": "^1.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
